{
  "name": "gestor-universitario",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs",
    "test:local:setup": "node scripts/setup-local-test.mjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && wrangler deploy",
    "db:migrate:remote": "wrangler d1 migrations apply gestor-universitario-prod --remote",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "jspdf": "^4.2.1",
    "lucide-react": "1.24.0",
    "next": "16.3.3",
    "pdfjs-dist": "6.3.289",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260921.1",
    "@opennextjs/cloudflare": "1.20.6",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/sql.js": "^1.4.11",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.3",
    "pdf-lib": "1.17.1",
    "typescript": "5.9.3",
    "wrangler": "4.135.0"
  },
  "packageManager": "pnpm@11.0.7"
}
